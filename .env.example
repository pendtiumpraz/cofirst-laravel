APP_NAME="Coding First"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# UI language: Bahasa Indonesia (lang/id), English as fallback.
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
# Timezone: the business runs on WIB. The effective timezone is the Settings key
# general.timezone (Admin > Pengaturan, default Asia/Jakarta); config/app.php's
# 'timezone' value is the fallback used before settings are loaded.
# APP_TIMEZONE=Asia/Jakarta

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development default: SQLite. Create the file and point DB_DATABASE at its
# ABSOLUTE path, then run: php artisan migrate:fresh --seed
#   (demo logins: superadmin@ / admin@ / finance@ / teacher@ / student@ /
#    parent@codingfirst.com, password "password")
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

# Production / MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=codingfirst
# DB_USERNAME=root
# DB_PASSWORD=

# Seeding: demo data is seeded in every environment except production.
# In production, db:seed only creates base data (roles, courses, curricula,
# badges/rewards, certificate template) plus this superadmin when both are set:
# (read through config/app.php 'seeding', so it also works after config:cache;
# remove SUPERADMIN_PASSWORD once the account exists)
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# SUPERADMIN_NAME="Super Admin"
# SEED_DEMO_DATA=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@codingfirst.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
